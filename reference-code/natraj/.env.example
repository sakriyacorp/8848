# Live Google reviews. Without the key the site falls back to data/reviews.json.
# Key: Google Cloud console → APIs & Services → enable "Places API (New)" → create an API key.
# Server-only: never prefix with NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=
# Optional. Defaults to the restaurant's public Place ID in src/lib/reviews.ts.
GOOGLE_PLACE_ID=ChIJv9KfLsAmtIkR04N0fjrd3bo

# Dish photos: node --env-file=.env.local scripts/fetch-images.mjs
PEXELS_API_KEY=

# Public site origin, used for Open Graph URLs and JSON-LD (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
